# Local server
PORT=4174
HOST=127.0.0.1
JOB_LOOKBACK_DAYS=30
CACHE_TTL_MS=300000
EMAIL_CONCURRENCY=8
REQUEST_TIMEOUT_MS=20000
LLM_REQUEST_TIMEOUT_MS=60000
DATA_DIR=./data
PROJECTS_DIR=./projects
OUTREACH_OWNER_NAME=Jack Lo
OUTREACH_OWNER_PHONE=51129438

# Hermes manager handoff
# file = write handoff bundle to HERMES_OUTBOX_DIR
# webhook = POST handoff bundle to HERMES_AGENT_WEBHOOK_URL
# both = write files and POST webhook
HERMES_HANDOFF_MODE=file
HERMES_OUTBOX_DIR=./data/hermes-outbox
HERMES_AGENT_WEBHOOK_URL=
HERMES_AGENT_TOKEN=
HERMES_REQUEST_TIMEOUT_MS=20000

# LLM analysis mode:
# rule = local heuristic only
# mock = local fake premium reviewer for testing pipeline/cost UI
# openrouter = OpenRouter Chat Completions compatible endpoint
# openai = OpenAI Chat Completions endpoint
LLM_ANALYSIS_PROVIDER=rule
LLM_ENABLE_NETWORK_ANALYSIS=0
LLM_TRIAGE_MAX_JOBS=300
LLM_CONCURRENCY=3
LLM_PREMIUM_SCORE_MIN=72
LLM_DAILY_USD_CAP=3
LLM_MONTHLY_USD_CAP=50
LLM_REVIEW_MODE=analysis_only
LLM_REVIEW_ALL_NEW_JOBS=1
LLM_JSON_RETRY_ON_PARSE_ERROR=1

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_ANALYSIS_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI direct
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional explicit pricing override for non-OpenAI/OpenRouter models.
LLM_INPUT_USD_PER_1M=0.0983
LLM_OUTPUT_USD_PER_1M=0.1966

# Pipeline runner
DASHBOARD_URL=http://127.0.0.1:4174
PIPELINE_LOOKBACK_DAYS=30
PIPELINE_LLM_LIMIT=300
